{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile document stored in Firestore keyed by Auth UID",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID from Firebase Authentication",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Full name or handle chosen by user",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar image URL or icon path",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["id", "email", "displayName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account documents stored per authenticated user"
    }
  }
}
